{
  "name": "armchain-website",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build && npm run optimize",
    "build:vercel": "npm run build && node -e \"require('fs-extra').copySync('.vinxi/build', 'dist')\"",
    "start": "vinxi start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . -c eslint.config.mjs --max-warnings 0",
    "format": "prettier --write .",
    "optimize": "npm run prune && npm run clean",
    "prune": "npm prune --production",
    "clean": "rm -rf .next .vinxi dist build"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.1",
    "@headlessui/react": "^2.2.7",
    "@openrouter/ai-sdk-provider": "^1.1.2",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.119.0",
    "@tanstack/react-start": "^1.119.0",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@trpc/tanstack-react-query": "^11.1.2",
    "ai": "^5.0.26",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.536.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "vinxi": "0.5.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-plugin-router": "^1.115.0",
    "@tanstack/router-generator": "^1.131.30",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "private": true,
  "type": "module"
}
